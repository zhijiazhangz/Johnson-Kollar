condition := false;
if #[e: e in eigenvalues | Gcd(e,order) eq 1] ge 1 then
condition := true; //This is the condition that some eigenvalue is a primitive Nth root of unity, where G = Z/N
end if;


//Part 4: Test to see if eigenvalues match those of the Jacobian of some curve(s)
//Source: "On a family of quotients of Fermat curves" by 
// Irokawa and Sasaki
//We compute the eigenvalues on the curve y^N = x^r (1-x)^s for each admissible pair (r,s)
if condition eq true then
match := false;
for rec in Subgroups(G) do //iterate over possible kernels K of permutation representation of G on product of Jacobians
K := rec`subgroup;
H := G/K;
if &+([p[1]^p[2]: p in Factorization(Order(H))] cat [0]) le h12 then //If first condition fails, 
//H cannot embed in S_m, m <= h^{1,2}(X), so we can skip this possibility. 

//list of eigenvalues of the induced representation on all of H^{2,1}(X) by G
for t in [t: t in [1 .. order-1]| Gcd(order, t) eq 1] do //we consider whether the list E matches our eigenvalues list after any outer automorphism of G
Et := {* t*a mod order: a in E *};
if Et subset eigenvalues then //this sees whether a product JC_1 x ... x JC_#H each with K-action, cyclically permuted by H, matches the eigenvalue set of H^{2,1}(X)
match := true;
print weights, deg, A, h12, Aut, gaction, eigenvalues, K, H, r, s, t, "Possibly Rational";
status := "Possibly Rational";
break rec;
end if;
end for;
end if;
end for;
end for;
end if;
end for;
if match eq false then
print weights, deg, A, h12, Aut, gaction, eigenvalues, "Irrational";
status := "Irrational";
Append(~irrational_polytope_list,<i,weights,deg,A,h12,Vertices(EquationToPolytope(weights,A))>);
break A; //Change this based on whether we want program to terminate after finding just one Delsarte irrational one in a family or not
end if;
end if;


end if;
end for;
end if;
Append(~status_list,<i,status>);
end for;
